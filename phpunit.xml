<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- The suite outgrew the CLI default (128M) at ~290 tests; this limit
             applies inside the PHPUnit process however it is launched. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- The suite exercises the KHQR feature, so the master gate is ON here.
             Its production default is OFF (config/services.php) — the zero-request
             guarantee is tested by flipping it back off per-test, in
             tests/Feature/RevenueExpense/KhqrZeroRequestTest.php. -->
        <env name="KHQR_PAY_ENABLED" value="true"/>
        <!-- The Bakong suite exercises the gates, so the master switch is ON
             here and the base URL points at a host that does not exist. A test
             that slips past the guards therefore fails loudly at
             Http::preventStrayRequests() rather than spending a metered request
             against whatever token the machine happens to have configured. -->
        <env name="BAKONG_API_ENABLED" value="true"/>
        <env name="BAKONG_API_BASE_URL" value="https://bakong.test"/>
        <env name="BAKONG_EMAIL" value="integrator@ams.test"/>
        <env name="BAKONG_ORGANIZATION" value="AMS Test"/>
        <env name="BAKONG_PROJECT" value="AMS"/>
        <env name="BAKONG_ACCOUNT_ID" value="ams_test@devb"/>
        <env name="BAKONG_DAILY_REQUEST_LIMIT" value="80"/>
        <env name="BAKONG_VERIFY_COOLDOWN" value="60"/>
        <env name="BAKONG_QR_TTL" value="6"/>
        <env name="BAKONG_MAX_VERIFY_ATTEMPTS" value="8"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
