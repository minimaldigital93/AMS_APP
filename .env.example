APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Use https in production. For local testing you can set to https://localhost or use ngrok/Valet.
APP_URL=https://localhost

# Set to true to force HTTPS scheme across the app (useful behind proxies or when testing HTTPS locally)
FORCE_HTTPS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
 DB_HOST=127.0.0.1
 DB_PORT=3306
 DB_DATABASE=AMS_APP
 DB_USERNAME=root
 DB_PASSWORD=Admin@1234

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# KHQRPay (khqr.cc) — Cambodia KHQR payments
KHQRPAY_BASE_URL=https://khqr.cc
KHQRPAY_PROFILE_ID=
KHQRPAY_SECRET=
KHQRPAY_BAKONG_ID=
KHQRPAY_MERCHANT_NAME="${APP_NAME}"
KHQRPAY_CURRENCY=USD

# --- Metered-token guards -------------------------------------------------
# Bakong meters the upstream token per calendar day and a REFUSED request costs
# the same as a successful one. These bound what this app can spend.
# Hard ceiling on live gateway calls per settlement target per day (0 = off).
# Past it, verify() answers "refused" instead of calling out — it never reads
# as "unpaid", so no payment row is settled or expired on a guess.
# 60, not 90: the two checkout preflight probes now count against this too, and
# 90 of a ~100/day allowance left no headroom for the calls that take money.
KHQRPAY_DAILY_BUDGET=60
# Minimum seconds between live calls for the SAME transaction. Every checkout
# poller funnels through it, so it is the single most effective throttle.
# Must stay >= the browser poll interval (POLL_MS, 10s) or it absorbs nothing.
KHQRPAY_VERIFY_COOLDOWN=60
# Minutes a QR stays payable — also caps how long one abandoned tab can poll.
KHQRPAY_QR_TTL=10
# Minutes past a QR's expiry that khqr:reconcile keeps re-verifying it. This is
# the quota bound on the safety net: it used to re-verify every open row for a
# full DAY, which with a 10-minute QR is 288 live calls per abandoned checkout.
KHQRPAY_RECONCILE_GRACE=60
# Master switch for that safety net. Set false while the khqr.cc profile has no
# active Bakong token: it cannot confirm anything then, so every run is quota
# spent on a question the gateway will not answer. Turn back ON once the token
# is active, or paid-but-unnotified payments stop being rescued.
KHQRPAY_RECONCILE_ENABLED=true

