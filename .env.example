APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Use https in production. For local testing you can set to https://localhost or use ngrok/Valet.
APP_URL=https://localhost

# Set to true to force HTTPS scheme across the app (useful behind proxies or when testing HTTPS locally)
FORCE_HTTPS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
 DB_HOST=127.0.0.1
 DB_PORT=3306
 DB_DATABASE=AMS_APP
 DB_USERNAME=root
 DB_PASSWORD=Admin@1234

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# How long a ticked "remember me" box lasts, in minutes (default 90 days).
# SESSION_LIFETIME above is the idle window for one visit; this is the one
# that decides how often a signed-in user is asked for their password again.
AUTH_REMEMBER_DURATION=129600

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Tenant rent KHQR — the LOCAL channel (config/rent_qr.php)
#
# A rent QR is built on this server from the landlord's own Bakong account id
# and confirmed BY THE LANDLORD in their banking app. It contacts nothing, so it
# has no credentials, no feature switch and no quota guards — there is nothing
# for them to protect. Rent money settles directly with the landlord and never
# passes through the platform's Bakong token.
#
# Minutes a rent QR stays payable before the checkout modal gives up on it.
RENT_QR_TTL=30
# Fallback when a landlord has saved no currency of their own.
RENT_QR_CURRENCY=USD
# Build an example QR for an account with no Bakong id configured, so the flow
# is demonstrable locally. HARD-DISABLED in production — an example QR collects
# nothing, and a tenant shown one would be told to pay into a demonstration.
RENT_QR_DEMO=false

# NOTE: every KHQR_PAY_* and KHQRPAY_* variable was removed in 2026-09 when the
# khqr.cc integration was deleted. If your .env still has them they are read by
# nothing — delete them, and revoke the secret at khqr.cc rather than leaving it
# live on an account this app no longer uses.


# =========================================================================
# Bakong Open API (National Bank of Cambodia) — DIRECT integration
# =========================================================================
# Replaces the KHQRPay (khqr.cc) middleman. Spec: "Bakong OpenAPI
# Documentation" v1.0.2, May 2021, NBC. See docs/BAKONG_MIGRATION.md.
#
# MASTER SWITCH. While false, NOTHING in this app contacts Bakong: not the
# scheduler, a page load, a status poll, a queue job, a command or the
# diagnostics report. Default false, deliberately — an absent variable must
# mean disabled, because the cost of shipping it off is one line of .env and
# the cost of shipping it on is a metered token drained overnight.
BAKONG_API_ENABLED=false
# The API root, supplied by NBC at integrator onboarding. The published
# document writes it as {{baseUrl}} and never states it, so it is not guessed
# anywhere in this codebase. EMPTY IS A SECOND OFF SWITCH: with nowhere to
# send a request the client refuses rather than calling an empty host.
BAKONG_API_BASE_URL=
# Local simulation — builds a real, scannable KHQR payload and settles it on a
# timer without contacting anyone, so the whole flow can be rehearsed before a
# single metered request is spent. It runs with NOTHING configured: no token, no
# account id, no base URL. Hard-disabled in production so it can never
# auto-confirm real money.
BAKONG_DEMO=false
# Seconds a demo payment waits before settling itself. The delay is the point —
# it exercises the spinner, the poll loop and the "check now" button rather than
# jumping straight to a confirmed page.
BAKONG_DEMO_SETTLE_AFTER=15

# --- Integrator identity --------------------------------------------------
# Bakong issues a token to an INTEGRATOR (email + organization + project), not
# to a merchant. That is why tenant rent stays on the manual channel: there is
# no per-landlord credential to issue, so one shared token would put every
# landlord's rent collection under a single ~100/day ceiling.
#
# THE TOKEN ITSELF IS NOT AN ENVIRONMENT VARIABLE. Run `php artisan
# bakong:token request`, then `bakong:token verify <code>` with the 20-character
# code Bakong emails here; it is stored encrypted in bakong_tokens and renewed
# from its own JWT expiry. Keeping it out of .env means a rotated token is
# never left in a shell history, a config cache or a .env backup.
#
# ALREADY HOLD A TOKEN (issued by NBC directly, or moved from another machine)?
# `php artisan bakong:token import` stores it, reads its expiry from the JWT and
# contacts nobody — zero requests, and it works before the master switch is on.
BAKONG_EMAIL=
BAKONG_ORGANIZATION=
BAKONG_PROJECT=
# Renew this many days before the JWT's own `exp` (NBC's sample tokens last
# ~93 days). Expiry is read from the token locally — asking the API when a
# token expires would spend the allowance to learn what the token already says.
BAKONG_TOKEN_RENEW_DAYS=7

# --- Platform KHQR identity (subscription payments) -----------------------
# Where subscription money lands, and the name/city printed inside the QR. The
# account id in the payload decides where funds settle — not the token that
# asks about the transaction afterwards. Landlord rent QRs do NOT read these;
# they carry that landlord's own merchant_payment_settings.bakong_account_id.
BAKONG_ACCOUNT_ID=
BAKONG_MERCHANT_NAME="${APP_NAME}"
BAKONG_MERCHANT_CITY="Phnom Penh"
BAKONG_CURRENCY=USD

# --- Quota protection -----------------------------------------------------
# Bakong meters the token per CALENDAR DAY and charges a refused request
# exactly like a paid one. There is also NO WEBHOOK, so polling is the only
# settlement signal and every poll is metered. These five bounds are the only
# things between a forgotten poller and a day with nothing left for a real
# payment. Tuned for ~8 calls per checkout.
#
# Hard daily ceiling, reserved atomically and FAILING CLOSED. Deliberately
# BELOW Bakong's own ~100: stopping short of the external limit makes hitting
# it a local event we can see, not an upstream refusal. 0 disables it.
BAKONG_DAILY_REQUEST_LIMIT=80
# Minimum seconds between live requests about the SAME transaction, claimed
# atomically BEFORE the request so it holds across tabs, workers and the
# reconcile run. MUST stay well above the 10s browser poll interval, or it
# absorbs nothing — that is how the KHQRPay integration learned this.
BAKONG_VERIFY_COOLDOWN=60
# Minutes a QR stays payable; also caps how long one abandoned tab can poll.
# 6 minutes against a 60s cooldown is ~6 calls, and that product is the point.
BAKONG_QR_TTL=6
# The most a SINGLE checkout may ever cost, across the poller, the "check now"
# button and the reconcile net together. The cooldown caps the rate and the TTL
# caps the window; this caps their product. 0 disables it.
BAKONG_MAX_VERIFY_ATTEMPTS=8
# Minutes to stop calling after a refusal that will be just as true next time
# (401/403 token, 429 allowance, 5xx). NOT tripped by a timeout: a timeout says
# nothing about the token, and the cooldown already prevents an instant retry.
BAKONG_FAILURE_BACKOFF=15
# Minutes to stop calling after Bakong itself answers 429. Independent of the
# ceiling above: it reacts to what the provider actually sent, so it protects
# an installation that set no ceiling at all.
BAKONG_RATE_LIMIT_BACKOFF=5

# --- Reconciliation safety net --------------------------------------------
# Under KHQRPay this net rescued payments whose WEBHOOK failed. Bakong sends no
# webhook, so there is no delivery failure to rescue — a payment is confirmed by
# a poll or it is not. That makes the net far less valuable here and exactly as
# expensive, so it ships OFF. Turn it on only where payers routinely close the
# tab before confirmation, and watch `bakong:usage` afterwards.
BAKONG_RECONCILE_ENABLED=false
# Minutes past expiry the net keeps asking. This is the quota bound on it:
# "leave it open and ask again" has no exit when the gateway never answers.
BAKONG_RECONCILE_GRACE=30

# --- Deeplink (open-in-Bakong-app) ----------------------------------------
# generate_deeplink_by_qr turns the KHQR string into a short link that opens the
# payer's Bakong app — something KHQRPay never offered. OFF by default: it costs
# a metered request per checkout and the QR alone is already payable. NBC's
# parameter table lists no Authorization header for this endpoint; confirm
# before relying on it either way.
BAKONG_DEEPLINK_ENABLED=false
BAKONG_DEEPLINK_ICON_URL=
BAKONG_DEEPLINK_APP_NAME="${APP_NAME}"
BAKONG_DEEPLINK_CALLBACK=

# No automatic retries anywhere in this integration: the ceiling counts upstream
# requests, so a retry spends two against one reservation — and a request that
# times out has still been charged.
BAKONG_CONNECT_TIMEOUT=3
BAKONG_TIMEOUT=8
